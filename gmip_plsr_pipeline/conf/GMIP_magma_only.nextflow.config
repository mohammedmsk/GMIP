//nextflow run ~/GMIP/workflows/GMIP_top0500_wf.nf -c ~/GMIP/conf/nextflow.config -profile local_conda -resume
params.magma_input = null
params.prefix           = 'NAFLD_popsFeatures'
params.outdir           = "outdir"

// Define the parameters, Most fixed for a location/cluster/laptop/ec2
params.base_refdir      = "${projectDir}/refdir"
params.script_dir       = projectDir
params.gene_annot_path  = "${projectDir}/bin/pops/example/data/utils/gene_annot_jun10.txt"

//
report.enabled          = true
report.file             = "${params.outdir}/report.html"
report.overwrite        = true

params {
  magma {
    executable   = "${projectDir}/bin/magma"  // install with: bash setup_magma.sh
    outdir       = "${params.outdir}/1_magma"
    prefix       = "${params.prefix}.magma"
    ref_pathdir  = "${params.base_refdir}/2_pops_files/data_from_dropbox"
    bfile_prefix = "1000G.EUR"
  }
}

profiles {

  // ── Primary profiles (executor + default environment) ─────────────────────
  local {
    process.executor = 'local'
    conda.enabled    = true
    docker.enabled   = false
  }

  slurm {
    process.executor       = 'slurm'
    singularity.enabled    = true
    singularity.autoMounts = true
    conda.enabled          = false
    docker.enabled         = false
  }

  aws_batch {
    process.executor = 'awsbatch'
    process.queue    = 'gmip-batch-queue'  // override: --process.queue YOUR_QUEUE
    docker.enabled   = true
    conda.enabled    = false
    aws.region       = 'us-east-1'         // override: edit here or set AWS_DEFAULT_REGION
  }

  // ── Environment overrides — combine with executor profile ─────────────────
  // Examples: -profile slurm,conda   -profile local,docker
  conda {
    conda.enabled  = true
    docker.enabled = false
  }

  docker {
    docker.enabled    = true
    conda.enabled     = false
    docker.runOptions = '-u $(id -u):$(id -g)'
  }

  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    conda.enabled          = false
    docker.enabled         = false
  }

  // ── Legacy aliases ────────────────────────────────────────────────────────
  local_conda    { process.executor = 'local'; conda.enabled = true; docker.enabled = false }
  slurm_conda    { process.executor = 'slurm'; conda.enabled = true; docker.enabled = false }
  sbatch_cluster { process.executor = 'slurm'; conda.enabled = true; docker.enabled = false }
}

process {
  withName: MAGMA {
    conda     = "${projectDir}/docker/environment_gmip.yml"
    container = 'ghcr.io/mohammedmsk/gmip-plsr:latest'
    tag    = "${params.prefix}"
    memory = '12GB'
    cpus   = 2
  }
}
